// Gestione del routing
const express = require("express");
const router = express.Router();
const path = require("path");
const paths = require("../../config/path");

router.get("/", (req, res) => {
  res.sendFile(path.join(paths.PUBLIC, "index.html"));
});

router.get("/codifica", (req, res) => {
  res.sendFile(path.join(paths.PUBLIC, "codifica.html"));
});

router.get("/decodifica", (req, res) => {
  res.sendFile(path.join(paths.PUBLIC, "decodifica.html"));
});

router.get("/bruteforce", (req, res) => {
  res.sendFile(path.join(paths.PUBLIC, "bruteforce.html"));
});

module.exports = router;